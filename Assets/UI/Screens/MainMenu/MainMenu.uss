.main-root {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(20, 20, 25);
}

.top-bar {
    flex-direction: row;
    padding: 12px;
}

.currency-item {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 4px 10px;
}

.currency-icon {
    color: rgb(255, 210, 90);
    margin-right: 6px;
    -unity-font-style: bold;
}

.currency-value {
    color: rgb(255, 255, 255);
    font-size: 16px;
}

.center-display {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.placeholder-text {
    color: rgba(255, 255, 255, 0.3);
    font-size: 18px;
}

.side-buttons {
    position: absolute;
    right: 12px;
    top: 80px;
    width: 100px;
}

.side-buttons > .app-button {
    margin-bottom: 8px;
}

.bottom-bar {
    align-items: center;
    padding-bottom: 24px;
}

.play-button {
    width: 200px;
    height: 60px;
    font-size: 20px;
    -unity-font-style: bold;
}

.version-label {
    color: rgba(255, 255, 255, 0.4);
    font-size: 10px;
    margin-top: 6px;
}
