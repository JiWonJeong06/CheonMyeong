/* 인게임 HUD - 내 기지/상대 기지의 HP·SP 바. 화면 위쪽 좌/우에 떠있는 형태. */

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    flex-direction: row;
    justify-content: space-between;
    padding: 12px;
}

.hud-panel {
    width: 220px;
    padding: 10px 14px;
    background-color: rgba(20, 20, 24, 0.75);
    border-radius: 8px;
}

.hud-panel-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.hud-panel-mine .hud-panel-title {
    color: rgb(120, 200, 255);
}

.hud-panel-enemy .hud-panel-title {
    color: rgb(255, 120, 120);
}

.stat-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.stat-label {
    width: 24px;
    color: rgb(210, 210, 210);
    font-size: 11px;
}

.bar-track {
    flex-grow: 1;
    height: 10px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 5px;
    overflow: hidden;
    margin: 0 6px;
}

.bar-fill {
    height: 100%;
    width: 100%;
}

.bar-fill-hp {
    background-color: rgb(90, 200, 110);
}

.bar-fill-sp {
    background-color: rgb(90, 160, 230);
}

.stat-value {
    width: 56px;
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-text-align: middle-right;
}
