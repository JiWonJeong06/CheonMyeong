/* 테크트리 팝업과 동일하게 화면의 85%를 차지하도록 확장 - 편성 슬롯 + 로스터를
   한 화면에 같이 보여줘야 해서 기존 640px 고정 크기로는 좁았음. */
.inventory-box {
    width: 85%;
    height: 85%;
}

.preset-tabs {
    flex-direction: row;
    align-self: stretch;
    margin-bottom: 8px;
}

.preset-tab {
    flex-grow: 1;
    height: 32px;
    margin: 0 2px;
    background-color: rgb(58, 58, 68);
    color: rgb(200, 200, 200);
    font-size: 12px;
}

.preset-tab.active {
    background-color: rgb(70, 110, 190);
    color: rgb(255, 255, 255);
}

.deck-slots {
    flex-direction: row;
    align-self: stretch;
    justify-content: center;
    margin-bottom: 8px;
}

.deck-slot {
    width: 84px;
    height: 100px;
    margin: 0 6px;
    align-items: center;
    justify-content: center;
    background-color: rgb(40, 40, 48);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(80, 80, 90);
    padding: 4px;
}

/* 빈 슬롯 - 점선 느낌으로 살짝 어둡게(점선 테두리는 UI Toolkit에서 지원 안 해서 색으로만 구분) */
.deck-slot.empty {
    border-color: rgb(60, 60, 68);
}

.deck-slot.empty .deck-slot-placeholder {
    color: rgb(90, 90, 100);
    font-size: 20px;
}

.deck-slot.filled {
    border-color: rgb(90, 150, 220);
}

.deck-slot-icon {
    width: 48px;
    height: 48px;
    background-color: rgb(90, 90, 100);
    border-radius: 6px;
}

.deck-slot-name {
    color: rgb(230, 230, 230);
    font-size: 10px;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-top: 4px;
}

.deck-actions {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    margin-bottom: 8px;
}

/* 저장 안 한 변경사항이 있을 때만 텍스트가 채워짐 (InventoryController에서 조건부로 설정) */
.deck-save-status {
    color: rgb(230, 180, 90);
    font-size: 11px;
    margin-right: 10px;
}

.deck-save-button {
    width: 100px;
    height: 28px;
}

.inventory-hint {
    color: rgb(170, 170, 170);
    font-size: 11px;
    -unity-text-align: upper-center;
    margin-bottom: 8px;
}

.inventory-scroll {
    flex-grow: 1;
    align-self: stretch;
    margin-bottom: 16px;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.character-slot {
    width: 96px;
    height: 120px;
    margin: 6px;
    align-items: center;
    background-color: rgb(58, 58, 68);
    border-radius: 8px;
    padding: 6px;
}

.character-icon {
    width: 64px;
    height: 64px;
    background-color: rgb(90, 90, 100);
    border-radius: 6px;
}

.character-name {
    color: rgb(230, 230, 230);
    font-size: 12px;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-top: 6px;
}

.character-cost {
    color: rgb(180, 180, 180);
    font-size: 11px;
    -unity-text-align: upper-center;
}

/* 미해금 상태 - 회색조 틴트 + 살짝 투명 처리로 "흑백" 느낌을 흉내냄.
   진짜 그레이스케일(채도 0)은 커스텀 셰이더가 필요해서 더미 단계에선 이 정도로 대체함. */
.character-slot.locked .character-icon {
    -unity-background-image-tint-color: rgb(110, 110, 110);
    opacity: 0.55;
}

.character-slot.locked .character-name {
    color: rgb(150, 150, 150);
}

.character-slot.unlocked .character-icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 1;
}

/* 현재 편성에 들어가있는 캐릭터 - 로스터에서도 구분되게 테두리로 강조 */
.character-slot.in-deck {
    border-width: 2px;
    border-color: rgb(90, 150, 220);
}
