.inventory-box {
    width: 640px;
    max-height: 480px;
}

.inventory-scroll {
    width: 100%;
    height: 340px;
    margin-bottom: 16px;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.character-slot {
    width: 96px;
    height: 120px;
    margin: 6px;
    align-items: center;
    background-color: rgb(58, 58, 68);
    border-radius: 8px;
    padding: 6px;
}

.character-icon {
    width: 64px;
    height: 64px;
    background-color: rgb(90, 90, 100);
    border-radius: 6px;
}

.character-name {
    color: rgb(230, 230, 230);
    font-size: 12px;
    -unity-text-align: upper-center;
    white-space: normal;
    margin-top: 6px;
}

.character-cost {
    color: rgb(180, 180, 180);
    font-size: 11px;
    -unity-text-align: upper-center;
}

/* 미해금 상태 - 회색조 틴트 + 살짝 투명 처리로 "흑백" 느낌을 흉내냄.
   진짜 그레이스케일(채도 0)은 커스텀 셰이더가 필요해서 더미 단계에선 이 정도로 대체함. */
.character-slot.locked .character-icon {
    -unity-background-image-tint-color: rgb(110, 110, 110);
    opacity: 0.55;
}

.character-slot.locked .character-name {
    color: rgb(150, 150, 150);
}

.character-slot.unlocked .character-icon {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    opacity: 1;
}
