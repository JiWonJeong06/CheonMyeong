/* 요청사항 1: 패널이 전체 화면의 70~90% 정도를 차지해야 함 - 85%로 고정.
   popup-root(Common.uss)가 화면 전체를 채우는 절대배치 컨테이너라, 퍼센트 값은
   화면 해상도 기준으로 계산됨. */
.techtree-box {
    width: 85%;
    height: 85%;
}

.techtree-canvas {
    position: relative;
    flex-grow: 1;
    align-self: stretch; /* popup-box의 align-items:center를 이 요소만 덮어써서 가로 전체 폭 사용 */
    background-color: rgb(28, 28, 34);
    border-radius: 8px;
    margin-bottom: 12px;
    overflow: hidden;
}

.techtree-toolbar {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-bottom: 8px;
}

.techtree-search-label {
    color: rgb(200, 200, 200);
    font-size: 12px;
    margin-right: 6px;
}

.techtree-search-field {
    flex-grow: 1;
}

.techtree-hint {
    color: rgb(170, 170, 170);
    font-size: 11px;
    -unity-text-align: upper-center;
    margin-bottom: 12px;
}

.tech-node {
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: 40px;
    align-items: center;
    justify-content: center;
    padding: 4px;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 10px;
}

/* 이미 해금됨 - 컬러(초록) */
.tech-node.unlocked {
    background-color: rgb(70, 150, 90);
    color: rgb(255, 255, 255);
}

/* 선행조건 충족 + 아직 미해금 - 눌러서 해금 가능 (강조색) */
.tech-node.available {
    background-color: rgb(70, 110, 190);
    color: rgb(255, 255, 255);
}

/* 선행조건 미충족 - 회색, 클릭 불가 느낌 */
.tech-node.unavailable {
    background-color: rgb(60, 60, 68);
    color: rgb(130, 130, 130);
}

/* 검색 일치 - 밝은 테두리로 강조 (UI Toolkit엔 box-shadow/글로우 효과가 없어서
   테두리 강조 + 나머지 노드 명도 감소 조합으로 "불빛이 들어온" 느낌을 냄) */
.tech-node.search-match {
    border-width: 3px;
    border-color: rgb(255, 225, 110);
}

/* 검색과 무관한 노드 - 명도(투명도)를 낮춰서 상대적으로 어둡게 */
.tech-node.search-dim {
    opacity: 0.25;
}
