/* 요청사항 1: 패널이 전체 화면의 70~90% 정도를 차지해야 함 - 85%로 고정.
   popup-root(Common.uss)가 화면 전체를 채우는 절대배치 컨테이너라, 퍼센트 값은
   화면 해상도 기준으로 계산됨. */
.techtree-box {
    width: 85%;
    height: 85%;
}

.techtree-canvas {
    position: relative;
    flex-grow: 1;
    align-self: stretch; /* popup-box의 align-items:center를 이 요소만 덮어써서 가로 전체 폭 사용 */
    background-color: rgb(28, 28, 34);
    border-radius: 8px;
    margin-bottom: 12px;
    overflow: hidden;
}

.techtree-toolbar {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-bottom: 8px;
}

.techtree-search-label {
    color: rgb(200, 200, 200);
    font-size: 12px;
    margin-right: 6px;
}

.techtree-search-field {
    flex-grow: 1;
}

.techtree-hint {
    color: rgb(170, 170, 170);
    font-size: 11px;
    -unity-text-align: upper-center;
    margin-bottom: 12px;
}

/* 노드 배경/테두리(육각형)는 C#(TechTreeController.HexagonVisual)에서 Painter2D로 직접 그림 -
   UI Toolkit 스타일시트만으로는 육각형 모양으로 자르거나 테두리를 못 그려서(border-radius는
   사각형/원형만 가능) 색상 상수도 전부 C# 쪽(UnlockedFillColor 등)에서 관리함.
   이 클래스는 위치/크기만 담당하고, 상태별(unlocked/available/unavailable/character-node/
   search-match/search-dim) 시각 표현은 HexagonVisual.Redraw()가 처리함. */
.tech-node {
    position: absolute;
    width: 80px;
    height: 80px;
}

/* 조직 허브 노드(천명회 등) - 일반 노드보다 크게. 채움/테두리 색은 C#(NodeTreeLineColors)에서 그림 */
.tech-node-hub {
    width: 100px;
    height: 100px;
}

.tech-node-hub-label {
    font-size: 14px;
    -unity-font-style: bold;
}

/* 검색과 무관한 노드 - 명도(투명도)를 낮춰서 상대적으로 어둡게 */
.tech-node.search-dim {
    opacity: 0.25;
}

/* 노드 안의 텍스트 라벨 - 육각형(HexagonVisual)과 같은 위치에 절대배치로 겹쳐서 표시 */
.tech-node-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 4px;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 10px;
    color: rgb(255, 255, 255);
}

/* 선행조건 미충족 노드는 글자색도 어둡게 - 배경(HexagonVisual.UnavailableFillColor)과 어울리게 */
.tech-node.unavailable .tech-node-label {
    color: rgb(130, 130, 130);
}

/* 정중앙 코어 노드 - 텍스트 없는 장식용 노드, 다른 노드보다 크게(C# CoreNodeSize와 맞춤) */
.tech-node-core {
    position: absolute;
    width: 110px;
    height: 110px;
}

/* [디버그 전용] 테스트용 전체 초기화 버튼 - 눈에 띄는 경고색으로 구분해서
   출시 전 삭제해야 한다는 걸 시각적으로도 상기시킴 */
.debug-reset-button {
    background-color: rgb(150, 60, 60);
    color: rgb(255, 255, 255);
    font-size: 11px;
    margin-left: 8px;
    padding: 2px 8px;
}

/* ===== 노드 상세창 (NodeDetailPanel - 코드로 생성되어 popup-root 위에 덮임) ===== */
.node-detail-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.45);
}

.node-detail-card {
    width: 420px;
    padding: 20px;
    background-color: rgb(48, 48, 58);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(90, 90, 105);
}

.node-detail-title {
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
}

.node-detail-subtitle {
    color: rgb(170, 170, 185);
    font-size: 12px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.node-detail-body {
    margin-bottom: 8px;
}

.node-detail-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 0;
}

.node-detail-row-label {
    width: 120px;
    color: rgb(170, 170, 185);
    font-size: 13px;
    white-space: normal;
}

.node-detail-row-value {
    color: rgb(255, 255, 255);
    font-size: 13px;
    white-space: normal;
}

.node-detail-row-change {
    margin-left: 8px;
    color: rgb(120, 210, 130);
    font-size: 13px;
    white-space: normal;
}

.node-detail-row-warning {
    margin-left: 8px;
    color: rgb(235, 110, 110);
    font-size: 13px;
    -unity-font-style: bold;
}

.node-detail-text {
    color: rgb(210, 210, 220);
    font-size: 12px;
    white-space: normal;
    margin: 4px 0;
}

.node-detail-reason {
    color: rgb(235, 110, 110);
    font-size: 12px;
    -unity-text-align: middle-center;
    min-height: 16px;
    margin-bottom: 8px;
}
